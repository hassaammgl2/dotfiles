{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-icat",
        "source": "/home/ratx86/.config/fastfetch/logo.png",
        "width": 22,
        "height": 22,
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        },
        "preserveAspectRatio": true
    },
    "display": {
        "pipe": false,
        "separator": "  ",
        "color": {
            "keys": "#F98860",
            "title": "#FFF749",
            "output": "#FFFCBF",
            "separator": "#BE6E5F"
        },
        "key": {
            "type": "icon"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}"
        },
        "separator",
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        {
            "type": "disk",
            "folders": ["/"]
        },
        {
            "type": "battery",
            "format": "{capacity} [{status}]"
        },
        "break",
        "colors"
    ]
}
